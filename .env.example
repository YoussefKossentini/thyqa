# Copy to .env (python tools/init_env.py does it with random secrets). Never commit .env.
# One key per service. No bank card is linked to any of them.

OPS_PIN=2468
AUTHZ_HMAC_SECRET=
AUDIT_ANCHOR_KEY=
POLICY_SIGNING_KEY=
INTERNAL_API_SECRET=

# LLM chain: Gemini -> Groq -> Ollama -> Replay -> MOCK (deterministic, never crashes)
THIQA_LLM_MODE=auto          # auto | mock | replay
THIQA_RECORD_REPLAY=0        # 1 during rehearsals: records LIVE answers into replay/*.jsonl
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b
LLM_TIMEOUT_S=8

# Telegram approvals (long polling, no public webhook). Each approver must /start the bot once.
TELEGRAM_BOT_TOKEN=
# format: <telegram_id>:<approver>,<telegram_id>:<approver>  (the bot tells you your id on /start)
TELEGRAM_APPROVERS=

THIQA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
THIQA_TIME_ANOMALY=1
THIQA_RATE_LIMIT_10S=60
